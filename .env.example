# Copy this file to .env and fill in your actual keys

# Google Gemini AI (get free key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq AI - Free key at https://console.groq.com (used for AI chatbox)
GROQ_API_KEY=your_groq_api_key_here

# Khalti Payment Gateway (TEST MODE)
# Sandbox key from https://test-admin.khalti.com/
# Use OTP: 987654 for testing
KHALTI_SECRET_KEY=your_khalti_secret_key_here

# API Base URL (sandbox)
KHALTI_API_BASE=https://dev.khalti.com/api/v2

# Website URL (where your app is hosted)
KHALTI_WEBSITE_URL=http://localhost/Doctor-Appointment-Booking-System

# Khalti will redirect here after payment completion
KHALTI_RETURN_URL=http://localhost/Doctor-Appointment-Booking-System/api/patient/khalti_payment_callback.php

# TEST MODE - Set to true for test payments
# Test Khalti IDs: 9800000000, 9800000001, 9800000002, etc.
# Test MPIN: 1111
# Test OTP: 987654
KHALTI_TEST_MODE=true
